# Copy to .env and fill in. Never commit .env.

# Router login (used by devices.yaml defaults)
CISCO_USERNAME=netmon
CISCO_PASSWORD=change-me
CISCO_ENABLE_SECRET=

# Anthropic API key for AI diagnosis (ai.enabled in settings.yaml). Get one at https://platform.claude.com
ANTHROPIC_API_KEY=

# TrackIT database (same values as the Teltonika SMS Console .env)
# IP of the TrackIT MariaDB server. Not 127.0.0.1 - inside Docker that is the container itself.
# If MariaDB runs on the same machine as Docker, use host.docker.internal
TRACKIT_DB_HOST=
TRACKIT_DB_PORT=3306
TRACKIT_DB_USER=root
TRACKIT_DB_PASSWORD=
TRACKIT_DB_NAME=trackitlive

# Who receives the alert emails (comma-separated) and the From address
CISCO_ALERT_RECIPIENT=dnurdiansyah@alliedrec.com.au
CISCO_ALERT_FROM=

# Direct SMTP (only used if notify.email.enabled is true in settings.yaml)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=alerts@harianda.co.id
SMTP_PASSWORD=change-me
ALERT_EMAIL_FROM=alerts@harianda.co.id
ALERT_EMAIL_TO=noc@harianda.co.id,danang@harianda.co.id

# Microsoft Teams / Slack webhooks
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
