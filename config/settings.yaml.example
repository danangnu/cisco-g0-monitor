# Copy to settings.yaml. Secrets come from .env via ${VAR}.

interval_seconds: 300        # how often every device is checked
max_workers: 10              # devices checked in parallel
ssh_timeout: 20
state_dir: /data             # state.json, events.jsonl, heartbeat (Docker volume)
log_level: INFO

ping:
  count: 5                   # pings per target, sourced from the monitored interface
  timeout: 2                 # seconds per ping
  min_success_percent: 60    # >= this on any target = internet OK

thresholds:
  failure: 2                 # consecutive failed checks before alerting (avoids flapping alerts)
  recovery: 2                # consecutive good checks before sending "restored"

alerts:
  on_ip_change_same_subnet: false   # true = also alert when the IP changes but the subnet is the same
  on_device_unreachable: true       # alert when SSH to the router fails
  send_recovery: true               # send "restored" messages
  repeat_every_minutes: 60          # reminder while still down; 0 = never repeat

# Stage 1 AI agent: when an alert fires, log in to the affected routers, run a fixed
# READ-ONLY command set (show / ping / traceroute), and ask Claude for a diagnosis that
# is put at the top of the alert. Alerts are still sent if this fails or is disabled.
ai:
  enabled: true
  api_key: ${ANTHROPIC_API_KEY}
  model: claude-sonnet-5-5         # claude-haiku-5-5 is cheaper/faster; claude-opus-5-5 is stronger
  max_per_hour: 6                  # cap on API calls per hour (a flapping link can't run up a bill)
  diagnose_reminders: false        # also diagnose the hourly "still down" reminders
  timeout_seconds: 90

# Stage 2: memory and trends. Everything below is stored in /data/history.db (SQLite).
history:
  retention_days: 90               # checks/events older than this are pruned (latest config is always kept)

trends:                            # warnings raised from history before a link actually fails
  enabled: true
  latency_ratio: 2.0               # 24h median latency >= 2x the previous week's median ...
  latency_min_increase_ms: 20      # ... and at least 20 ms higher -> LATENCY_DEGRADED
  loss_threshold_percent: 90       # 24h average ping success below this while "up" -> PACKET_LOSS
  flap_incidents_24h: 3            # this many outages in 24h -> FLAPPING
  repeat_hours: 24                 # each warning at most once per device per day

backup:                            # daily `show running-config`, redacted, diffed against the previous one
  enabled: true
  hour: 3                          # local time; runs in the first cycle after this hour
  warn_on_change: true             # CONFIG_CHANGED alerts (with the diff) when a config differs

report:                            # weekly summary: uptime, outages, latency, config changes per router
  enabled: true
  weekday: 0                       # 0 = Monday
  hour: 8
  days: 7
  use_ai: true                     # one Claude call per week for the narrative on top of the table

# Stage 3: remediation with approval. Claude may propose ONE fix from a fixed catalogue
# (clear ARP/NAT, renew DHCP lease, bounce G0/0). Nothing runs until you execute
# `--approve <ID>` on the monitor PC; the fault is re-checked first.
actions:
  enabled: true
  expire_hours: 4                  # a proposal you don't act on expires after this
  cooldown_hours: 6                # same action on the same router at most once per 6h
  max_per_day: 4                   # hard cap on executed actions across the fleet per 24h

notify:
  # Same as the Teltonika SMS Console: alerts are queued in TrackIT `logbulkmail`
  # (mailstatus 'Queue in Database') and TrackIT's mailer sends them.
  trackit:
    enabled: true
    db_host: ${TRACKIT_DB_HOST}
    db_port: ${TRACKIT_DB_PORT:-3306}
    db_user: ${TRACKIT_DB_USER}
    db_password: ${TRACKIT_DB_PASSWORD}
    db_name: ${TRACKIT_DB_NAME:-trackitlive}
    to: ${CISCO_ALERT_RECIPIENT}           # comma-separated; one logbulkmail row per recipient
    from: ${CISCO_ALERT_FROM}              # logbulkmail.spoofas (blank = recipient, like Teltonika)
    from_name: Cisco G0/0 Monitor          # logbulkmail.spoofname
    priority: 1

  email:                                   # direct SMTP - off; TrackIT handles email
    enabled: false
    host: ${SMTP_HOST}
    port: ${SMTP_PORT:-587}
    security: ${SMTP_SECURITY:-starttls}   # starttls | ssl | none
    username: ${SMTP_USERNAME}
    password: ${SMTP_PASSWORD}
    from: ${ALERT_EMAIL_FROM}
    to: ${ALERT_EMAIL_TO}                  # comma-separated list
  teams:
    enabled: true
    webhook_url: ${TEAMS_WEBHOOK_URL}      # Teams Workflows "Post to a channel when a webhook request is received"
  slack:
    enabled: false
    webhook_url: ${SLACK_WEBHOOK_URL}
